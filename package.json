{
  "name": "@simplepush/mcp",
  "version": "0.1.0",
  "description": "MCP server for Simplepush. Agents send tasks and notifications to people's phones, wait for the answers, and query the record of what came back: tasks, answers, replies, and submissions.",
  "mcpName": "sh.simplepu/mcp",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "simplepush-mcp": "./dist/index.mjs",
    "simplepush-mcp-http": "./dist/http.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector --cli node dist/index.mjs",
    "start:http": "node dist/http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@simplepush/sdk": "^0.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsdown": "^0.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
